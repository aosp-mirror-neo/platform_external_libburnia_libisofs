package {
    default_applicable_licenses: ["external_libburnia_libisofs_license"],
}

license {
    name: "external_libburnia_libisofs_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-GPL-2.0",
    ],
    license_text: [
        "COPYING",
        "COPYRIGHT",
    ],
}

cc_library_host_static {
    name: "libisofs",
    defaults: ["libburnia_defaults"],
    srcs: [
        "libisofs/builder.c",
        "libisofs/node.c",
        "libisofs/tree.c",
        "libisofs/find.c",
        "libisofs/image.c",
        "libisofs/fsource.c",
        "libisofs/fs_local.c",
        "libisofs/fs_image.c",
        "libisofs/messages.c",
        "libisofs/libiso_msgs.c",
        "libisofs/stream.c",
        "libisofs/filter.c",
        "libisofs/filters/external.c",
        "libisofs/filters/zisofs.c",
        "libisofs/filters/gzip.c",
        "libisofs/util.c",
        "libisofs/util_rbtree.c",
        "libisofs/util_htable.c",
        "libisofs/filesrc.c",
        "libisofs/ecma119.c",
        "libisofs/ecma119_tree.c",
        "libisofs/buffer.c",
        "libisofs/rockridge.c",
        "libisofs/rockridge_read.c",
        "libisofs/joliet.c",
        "libisofs/hfsplus.c",
        "libisofs/hfsplus_decompose.c",
        "libisofs/hfsplus_classes.c",
        "libisofs/hfsplus_case.c",
        "libisofs/eltorito.c",
        "libisofs/system_area.c",
        "libisofs/make_isohybrid_mbr.c",
        "libisofs/iso1999.c",
        "libisofs/data_source.c",
        "libisofs/aaip_0_2.c",
        "libisofs/md5.c",
    ],
    export_include_dirs: ["."],
    stl: "none",
    visibility: ["//external/libburnia:__subpackages__"],
}
